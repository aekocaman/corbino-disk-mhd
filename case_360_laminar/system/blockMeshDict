FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Step-1 mesh: full 360-degree Corbino annulus (no wedge symmetry).
//
// Topology: 4 hex blocks, one per quadrant, sharing 16 vertices.
// Each block's local (x, y, z) maps to (+r, +theta, +z) in the right-handed
// sense -- this avoids the "Small Determinant" Jacobian collapse that hit
// the wedge mesh when an arc edge was reversed.
//
// Geometry (all in mm; converted to m by convertToMeters 0.001):
//   r_in  = 20 mm  (inner electrode)
//   r_out = 100 mm (outer electrode)
//   h     = 10 mm  (insulating top + bottom plates)
//   Gamma = (r_out - r_in)/h = 8
//
// Mesh sizing target (matches the wedge HLR convention):
//   delta_Ha = h/Ha ~ 0.053 mm   (Ha ~ 190 for Galinstan at B = 0.5 T)
//   HLR = delta_Ha / dz_wall >= 8   =>   dz_wall <= 6.6 um
//
// Hyperbolic z-grading is symmetric about z = h/2, with first cell ~6.5 um at
// each insulating plate (Hartmann layer) growing geometrically to ~2.9 mm at
// the core.  With 16 z-cells (8 per half) we use a steeper expansion ratio
// to preserve the wall HLR target while halving the total cell count from
// the original 32-cell mesh.  Multi-grading syntax does this in one block:
//      simpleGrading (1 1 ((0.5 0.5 450) (0.5 0.5 0.00222)))
// - segment 1: lower 50% of z, 50% of cells, last/first ratio = 450
// - segment 2: upper 50% of z, 50% of cells, ratio = 1/450 (mirror)
//
// Trade-off:  the bulk z-resolution is now ~2.9 mm at midplane (vs 1.5 mm in
// the 32-cell version).  Aspect ratio at midplane is ~3:1, acceptable for
// the laminar baseline but should be refined for higher-Re or turbulent runs.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.001;     // dictionary entries are in millimetres

// ---------------------------------------------------------------------------
// Vertices
// 16 total: 8 on the bottom plane (z = 0), 8 on the top plane (z = 10 mm).
// Indexed CCW around each circle, inner ring first then outer ring.
// ---------------------------------------------------------------------------
vertices
(
    // --- z = 0 plane, inner ring (r = 20 mm) ---
    ( 20    0    0)   //  0 : theta =   0
    (  0   20    0)   //  1 : theta =  90
    (-20    0    0)   //  2 : theta = 180
    (  0  -20    0)   //  3 : theta = 270

    // --- z = 0 plane, outer ring (r = 100 mm) ---
    ( 100    0    0)  //  4 : theta =   0
    (   0  100    0)  //  5 : theta =  90
    (-100    0    0)  //  6 : theta = 180
    (   0 -100    0)  //  7 : theta = 270

    // --- z = 10 mm plane, inner ring ---
    ( 20    0   10)   //  8
    (  0   20   10)   //  9
    (-20    0   10)   // 10
    (  0  -20   10)   // 11

    // --- z = 10 mm plane, outer ring ---
    ( 100    0   10)  // 12
    (   0  100   10)  // 13
    (-100    0   10)  // 14
    (   0 -100   10)  // 15
);

// ---------------------------------------------------------------------------
// Blocks
// Each hex follows the OpenFOAM convention:
//   (v0 v1 v2 v3  v4 v5 v6 v7)  with  local +x = v0->v1,
//                                     local +y = v0->v3,
//                                     local +z = v0->v4.
// We force local x = +r (radial out), local y = +theta (CCW), local z = +z.
// ---------------------------------------------------------------------------
blocks
(
    // Block Q1 :  theta in [  0,  90]
    hex (0 4 5 1   8 12 13 9)
        (60 80 16)
        simpleGrading (1 1 ((0.5 0.5 450) (0.5 0.5 0.00222)))

    // Block Q2 :  theta in [ 90, 180]
    hex (1 5 6 2   9 13 14 10)
        (60 80 16)
        simpleGrading (1 1 ((0.5 0.5 450) (0.5 0.5 0.00222)))

    // Block Q3 :  theta in [180, 270]
    hex (2 6 7 3   10 14 15 11)
        (60 80 16)
        simpleGrading (1 1 ((0.5 0.5 450) (0.5 0.5 0.00222)))

    // Block Q4 :  theta in [270, 360]
    hex (3 7 4 0   11 15 12 8)
        (60 80 16)
        simpleGrading (1 1 ((0.5 0.5 450) (0.5 0.5 0.00222)))
);

// ---------------------------------------------------------------------------
// Edges
// Each pair of consecutive ring vertices is joined by a circular arc whose
// midpoint sits on the corresponding cylinder.  The midpoint of a 90-degree
// arc at radius R lies at (R cos 45, R sin 45) = (R/sqrt 2, R/sqrt 2).
//   inner cylinder midpoint magnitude = 20 / sqrt 2 ~ 14.142
//   outer cylinder midpoint magnitude = 100 / sqrt 2 ~ 70.711
// ---------------------------------------------------------------------------
edges
(
    // -- Inner cylinder, z = 0 --
    arc  0  1 ( 14.1421  14.1421   0)
    arc  1  2 (-14.1421  14.1421   0)
    arc  2  3 (-14.1421 -14.1421   0)
    arc  3  0 ( 14.1421 -14.1421   0)

    // -- Outer cylinder, z = 0 --
    arc  4  5 ( 70.7107  70.7107   0)
    arc  5  6 (-70.7107  70.7107   0)
    arc  6  7 (-70.7107 -70.7107   0)
    arc  7  4 ( 70.7107 -70.7107   0)

    // -- Inner cylinder, z = 10 --
    arc  8  9 ( 14.1421  14.1421  10)
    arc  9 10 (-14.1421  14.1421  10)
    arc 10 11 (-14.1421 -14.1421  10)
    arc 11  8 ( 14.1421 -14.1421  10)

    // -- Outer cylinder, z = 10 --
    arc 12 13 ( 70.7107  70.7107  10)
    arc 13 14 (-70.7107  70.7107  10)
    arc 14 15 (-70.7107 -70.7107  10)
    arc 15 12 ( 70.7107 -70.7107  10)
);

// ---------------------------------------------------------------------------
// Boundary patches
// Three patches survive the wedge -> 360 transition:
//   innerElectrode   (r = r_in,  fixed potential, no slip)
//   outerElectrode   (r = r_out, ground V = 0,    no slip)
//   insulatingPlates (z = 0 and z = h, n . J = 0, no slip)
// The previous 'sides' (wedge symmetry) patch is gone; in 360 there is
// no symmetry plane to enforce.
//
// Face vertex order for each block follows the local-face convention.
// A hex local face X-min uses local indices (0 4 7 3); the resulting normal
// points in the local -x direction, which for our blocks is -r -- i.e. OUT
// of the fluid through the inner electrode.  Same logic gives outward normals
// for X-max (outer electrode), Z-min (bottom plate), Z-max (top plate).
// ---------------------------------------------------------------------------
boundary
(
    innerElectrode
    {
        type patch;
        faces
        (
            (0  8  9  1)   // Q1 X-min
            (1  9 10  2)   // Q2 X-min
            (2 10 11  3)   // Q3 X-min
            (3 11  8  0)   // Q4 X-min
        );
    }

    outerElectrode
    {
        type patch;
        faces
        (
            ( 4  5 13 12)  // Q1 X-max
            ( 5  6 14 13)  // Q2 X-max
            ( 6  7 15 14)  // Q3 X-max
            ( 7  4 12 15)  // Q4 X-max
        );
    }

    insulatingPlates
    {
        type wall;
        faces
        (
            // -- bottom (z = 0), outward normal = -z --
            ( 0  1  5  4)  // Q1 Z-min
            ( 1  2  6  5)  // Q2 Z-min
            ( 2  3  7  6)  // Q3 Z-min
            ( 3  0  4  7)  // Q4 Z-min

            // -- top (z = 10 mm), outward normal = +z --
            ( 8 12 13  9)  // Q1 Z-max
            ( 9 13 14 10)  // Q2 Z-max
            (10 14 15 11)  // Q3 Z-max
            (11 15 12  8)  // Q4 Z-max
        );
    }
);

mergePatchPairs
(
);

