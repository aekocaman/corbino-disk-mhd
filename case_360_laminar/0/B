FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      B;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Uniform axial magnetic field, applied externally, B = 0.5 T along +z.
//
// BC convention follows the OF13 mhdFoam Hartmann tutorial:
//   - On walls perpendicular to B (here the insulating plates at z = 0, h),
//     fix B as a Dirichlet condition
//   - On walls parallel to B (the cylindrical electrodes),
//     zeroGradient condition applies
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -2 0 0 -1 0];   // T = kg s^-2 A^-1

internalField   uniform (0 0 0.5);

boundaryField
{
    innerElectrode   { type zeroGradient; }
    outerElectrode   { type zeroGradient; }

    insulatingPlates
    {
        type            fixedValue;
        value           uniform (0 0 0.5);
    }
}

