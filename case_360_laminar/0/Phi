FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Phi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Inner-electrode potential, with a linear ramp:
//
//
//  For target current I = 500 A the laminar 1/r distribution requires
//       V_in = I * ln(r_out/r_in) / (2 pi sigma h)
//            = 500 * ln(5) / (2 pi * 3.46e6 * 0.01)
//            ~ 3.703e-3 V   = 3.7 mV.
//
// RAMP:
//   Holding V_in fixed at 3.7 mV from t = 0 still gives an impulsive
//   J x B kick because u_theta = 0 initially and the back-EMF term
//   (u x B) cannot oppose the driving E_r yet.  But that caused unlimited grow of
//   Courant number. Hence, V_in is linearly ramped
//   over t_ramp = 50 ms ~ 7 * tau_A so to let u_theta build up gradually so
//   the back-EMF develops alongside the driving field and the Courant
//   number stays bounded.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];   // V = kg m^2 s^-3 A^-1

internalField   uniform 0;

boundaryField
{
    innerElectrode
    {
        // Linear ramp 0 -> 3.7 mV over 50 ms, then hold.
        // table format:  (time  value)  pairs.
        type            uniformFixedValue;
        uniformValue    table
        (
            (0.000   0.0     )
            (0.050   3.703e-3)
            (1e10    3.703e-3)
        );
    }

    outerElectrode
    {
        type            fixedValue;
        value           uniform 0;
    }

    insulatingPlates
    {
        // n . J = 0   <=>   dPhi/dn = 0   for purely Ohmic conductor.
        type            zeroGradient;
    }
}

