FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Initial velocity + boundary conditions for the laminar baseline.
//
// All physical surfaces are no-slip.  
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];   // m s^-1

internalField   uniform (0 0 0);

boundaryField
{
    innerElectrode
    {
        type            noSlip;
    }

    outerElectrode
    {
        type            noSlip;
    }

    insulatingPlates
    {
        // Where Hartmann layers form 
        type            noSlip;
    }
}

