/*--------------------------------*- C++ -*----------------------------------*\
| =========                 |                                                 |
| \\      /  F ield         | OpenFOAM 13 (Foundation)                        |
|  \\    /   O peration     | epotMhdFoam — low-Rm electric-potential MHD     |
|   \\  /    A nd           | corbino_turbulance — PRODUCTION fvSolution      |
|    \\/     M anipulation  |                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Production linear-solver settings for the 64.5 M-cell DNS.
//
// Inherits the GAMG-Phi tuning verified in the laptop debug case:
//   - Phi solver:    GAMG / DICGaussSeidel
//   - p   solver:    GAMG / DICGaussSeidel
//   - U,B solvers:   PBiCGStab / DILU
//
// On the debug mesh this configuration delivers Phi convergence in
// 2-5 iterations/step (vs 320-400 with the OpenFOAM-default PCG/DIC),
// a ~100x reduction.  
//
// Tolerances are tightened slightly compared to debug because cluster
// runs span 10x more time steps and the cumulative continuity drift
// must stay below 1e-9 over the 4.5 s integration window.
//
// nCorrectors = 2 in PISO is the OpenFOAM 13 default; sufficient for
// adaptive-Dt PISO at maxCo = 0.3.  nNonOrthogonalCorrectors = 1 since
// the production mesh has max non-ortho < 60 deg.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-08;
        relTol          0.005;     // tighter than debug's 0.01
    }
    pFinal
    {
        $p;
        relTol          0;
    }

    pB
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-07;
        relTol          0.01;
    }
    pBFinal
    {
        $pB;
        relTol          0;
    }

    "(U|B)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;     // tighter than debug's 1e-08
        relTol          0;
    }

    Phi
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-09;     // tighter than debug's 1e-08
        relTol          0.005;     // cold-start cushion; absolute tol
                                   // takes over once init residual < 1e-7
    }
}

PISO
{
    nCorrectors              2;
    nNonOrthogonalCorrectors 1;
    pRefCell                 0;
    pRefValue                0;
}

BPISO
{
    nCorrectors              2;
    nNonOrthogonalCorrectors 1;
    pRefCell                 0;
    pRefValue                0;
}

// ************************************************************************* //
