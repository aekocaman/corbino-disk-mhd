FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
//
// numberOfSubdomains
//   - 4   : minimum, for a 4-core laptop  (~ 0.58 M cells / rank)
//   - 8   : default for an 8-core laptop  (~ 0.29 M cells / rank, sweet spot)
//   - 16  : oversubscribe a 4P/8L laptop only if RAM allows
//
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 8;      // raise/lower to match laptop physical-core count

method            scotch;

distributed       no;

roots             ( );

