/*--------------------------------*- C++ -*----------------------------------*\
| =========                 |                                                 |
| \\      /  F ield         | OpenFOAM 13 (Foundation)                        |
|  \\    /   O peration     | epotMhdFoam — low-Rm electric-potential MHD     |
|   \\  /    A nd           | corbino_turbulance_debug — LONG-RUN controls    |
|    \\/     M anipulation  |                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     epotMhdFoam;

startFrom       latestTime;     // resume from 0/ on a cold start, or from
                                // any partial snapshot if relaunched
startTime       0;

stopAt          endTime;
endTime         0.5;            // 500 ms physical (~0.36 tau_H)

// --- Time-step control ---------------------------------------------------
deltaT          1e-5;           // seed; CFL controller will grow it.  Larger
                                // than the smoke seed (1e-6) since by t=0
                                // the velocity field is U=0 and the first
                                // few steps are Lorentz spin-up only.
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       5e-4;           // hard cap; same as smoke for consistency

// --- Write control -------------------------------------------------------
writeControl    adjustableRunTime;
writeInterval   0.01;           // 10 ms snapshots -> 50 frames over 0.5 s
purgeWrite      0;              // keep all frames; override if disk is tight
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;          // allows live edits to endTime / stopAt

// --- Function objects ---------------------------------------------------
functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   10;            // every 10 steps; ~500-2000 lines
                                       // total over the run -> tractable
        fields          (U Phi J);
        probeLocations
        (
            ( 0.040  0.0    0.005 )    //  r = 4 cm,  midplane
            ( 0.060  0.0    0.005 )    //  r = 6 cm,  midplane
            ( 0.080  0.0    0.005 )    //  r = 8 cm,  midplane
            ( 0.060  0.0    0.0007)    //  r = 6 cm,  z = 0.7 mm (just above wall layer)
            ( 0.0    0.060  0.005 )    //  r = 6 cm @ theta = 90, midplane
        );
    }
}

// ************************************************************************* //
